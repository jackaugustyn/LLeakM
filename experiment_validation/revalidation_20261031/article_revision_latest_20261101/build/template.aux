\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Executed reconstruction pipeline. Unmodified conditions pass lengths directly to segmentation. Candidate selection precedes each context update; the first segment has no reconstructed context. Main and new-reference runs decode all segments with three samples per segment; 96-token pilots allow up to three segments with three samples each; the five-seed MAP study uses one sample for the first segment per seed. The 80-token encoder limit includes the instruction and context. All settings score their output against the full stored response.\relax }}{6}{figure.caption.2}\protected@file@percent }
\newlabel{fig:pipeline}{{2}{6}{Executed reconstruction pipeline. Unmodified conditions pass lengths directly to segmentation. Candidate selection precedes each context update; the first segment has no reconstructed context. Main and new-reference runs decode all segments with three samples per segment; 96-token pilots allow up to three segments with three samples each; the five-seed MAP study uses one sample for the first segment per seed. The 80-token encoder limit includes the instruction and context. All settings score their output against the full stored response.\relax }{figure.caption.2}{}}
\newlabel{fig:pipeline@cref}{{[figure][2][]2}{[1][5][]6}}
