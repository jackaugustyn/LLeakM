\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Five-seed evaluation on logged traces from a 512-token victim budget ($n=30$ prompts per model; 150 reconstructions per setting). Only the first heuristic segment is decoded, with 80-token T5 input and output limits, and scored against the full response reference. Segmentation and encoder coverage differ across transformations. MAP calibration uses 270 exact-prompt-disjoint traces per model but shares scenario templates. Intervals are crossed bootstrap 95\% CIs over prompts and seeds; SD describes the five seed-specific means. Reduction is $100(1-\bar  \phi /\bar  \phi _{\mathrm  {baseline}})$; negative values denote scores above baseline.\relax }}{16}{table.caption.15}\protected@file@percent }
\newlabel{tab:robustness}{{11}{16}{Five-seed evaluation on logged traces from a 512-token victim budget ($n=30$ prompts per model; 150 reconstructions per setting). Only the first heuristic segment is decoded, with 80-token T5 input and output limits, and scored against the full response reference. Segmentation and encoder coverage differ across transformations. MAP calibration uses 270 exact-prompt-disjoint traces per model but shares scenario templates. Intervals are crossed bootstrap 95\% CIs over prompts and seeds; SD describes the five seed-specific means. Reduction is $100(1-\bar \phi /\bar \phi _{\mathrm {baseline}})$; negative values denote scores above baseline.\relax }{table.caption.15}{}}
\newlabel{tab:robustness@cref}{{[table][11][]11}{[1][16][]16}}
