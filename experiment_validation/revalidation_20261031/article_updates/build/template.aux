\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Recovery-score reduction versus protected-payload overhead, averaged over the two 96-token pilot models ($n=30$ prompts each; documented recipe: up to three heuristic segments, 80-token T5 input and output limits, full-response reference). The randomized-padding point ($^{*}$) combines expected overhead (81.4\%) with the archived score reduction; it is not a joint measurement of a recovered padding realization. Batching has zero payload-sum overhead here and changes the frame count; latency was not measured. The plot describes the frozen pipeline, including its segment and input-coverage changes, rather than information-theoretic privacy.\relax }}{16}{figure.caption.14}\protected@file@percent }
\newlabel{fig:defense_tradeoff}{{4}{16}{Recovery-score reduction versus protected-payload overhead, averaged over the two 96-token pilot models ($n=30$ prompts each; documented recipe: up to three heuristic segments, 80-token T5 input and output limits, full-response reference). The randomized-padding point ($^{*}$) combines expected overhead (81.4\%) with the archived score reduction; it is not a joint measurement of a recovered padding realization. Batching has zero payload-sum overhead here and changes the frame count; latency was not measured. The plot describes the frozen pipeline, including its segment and input-coverage changes, rather than information-theoretic privacy.\relax }{figure.caption.14}{}}
\newlabel{fig:defense_tradeoff@cref}{{[figure][4][]4}{[1][13][]16}}
